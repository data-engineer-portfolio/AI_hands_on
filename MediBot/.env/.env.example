# Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model for generation / SQL translation
GROQ_MODEL=llama-3.1-70b-versatile

# Local Qdrant storage path (no Docker/cloud needed)
QDRANT_PATH=./qdrant_data

# Path to SQLite relational DB
SQLITE_DB_PATH=../data/mediassist.db

# Embedding model (local, via sentence-transformers / fastembed)
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# Reranker model (local cross-encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# JWT secret for session tokens
JWT_SECRET=change_this_to_a_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
